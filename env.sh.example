# Machine-local configuration for the jyut-ocr-proofread skill:
# ${XDG_CONFIG_HOME:-$HOME/.config}/jyut-ocr/env.sh.
#
# ./install.sh writes this file and keeps every line it does not own: run it
# instead of copying this example by hand.  It reads the keys below without
# running the file; paths may use $HOME, nothing else.  Agents source the file
# before running a bundled script.  Nothing here is portable: paths, ports and
# service commands differ per machine, which is why it does not live in the skill.

# --- written by the installer --------------------------------------------------
# The request (auto, or an override such as hunyuan) and the engines installed.
export JYUT_OCR_ENGINE="auto"
export JYUT_OCR_ENGINES="hunyuan,paddle"
# The device request; OCR_HUNYUAN_DEVICE and OCR_PADDLE_DEVICE are what auto chose.
export JYUT_OCR_DEVICE="auto"
export JYUT_OCR_PYTHON="$HOME/.local/share/jyut-ocr/python/bin/python"

# Engine B: HunyuanOCR (GGUF on a pinned llama.cpp llama-server).
export HUNYUAN_MODEL="$HOME/.local/share/jyut-ocr/models/REVISION/HunyuanOCR-bf16.gguf"
export HUNYUAN_MMPROJ="$HOME/.local/share/jyut-ocr/models/REVISION/mmproj-HunyuanOCR-bf16.gguf"
export HUNYUAN_LLAMA_SERVER="$HOME/.local/share/jyut-ocr/runtimes/COMMIT-release-NAME/bin/llama-server"
export OCR_HUNYUAN_DEVICE="cuda"
export OCR_HUNYUAN_MODE="shared"
# Simultaneous requests of the one shared server (KV cache per slot: about
# 1.5 GiB at the default 16384 context; the setup test checks they fit).
export OCR_HUNYUAN_SLOTS="1"

# Engine A: PaddleOCR-VL (its own Python 3.12 environment, pinned weights).
export PADDLEOCR_PYTHON="$HOME/.local/share/jyut-ocr/paddle-python/bin/python"
export OCR_PADDLE_DEVICE="gpu:0"
export PADDLE_VL_MODEL_DIR="$HOME/.local/share/jyut-ocr/paddle-models/PaddleOCR-VL-1.6/REVISION"
export PADDLE_LAYOUT_MODEL_DIR="$HOME/.local/share/jyut-ocr/paddle-models/PP-DocLayoutV3/REVISION"

# --- a local proofreading model (optional) -----------------------------------------
# ./install.sh --local-model-endpoint URL --local-model-name NAME writes these.
# NAME is the model ID exactly as the server lists it and as the agent names
# it; when the agent itself runs on this model, proofread_pages.py calls it over
# HTTP and refuses packet mode (images never enter the agent's context).
# export PROOFREAD_ENDPOINT="http://127.0.0.1:8080/v1/chat/completions"
# export PROOFREAD_MODEL="your-model-id"
# Requests the server runs at once (--local-model-concurrency N writes it):
# the default of proofread_pages.py --max-inflight and, over HTTP, of
# book_profile.py --workers, so rule set B passes neither.  Set it to the
# server's own concurrency: a request the server cannot admit waits in its
# queue and fails after its pending timeout.  Unset, each script's --workers.
# export PROOFREAD_MAX_INFLIGHT=8

# --- GPU hand-over (optional): the OCR engines and the model cannot share the GPU ---
# --local-model-release-cmd CMD --local-model-restore-cmd CMD write these.
# scripts/run_ocr_phase.py stops the model, runs the OCR, and starts it again.
# The restore command must be safe to repeat: a watchdog runs it again if the
# hand-over is killed mid-way.  The release must only stop the service, never
# disable it.
# export OCR_PHASE_RELEASE_CMD="your-service-manager stop your-model-service"
# export OCR_PHASE_RESTORE_CMD="your-service-manager start your-model-service"
# A URL that answers 2xx once the model serves again (default: the endpoint's /v1/models).
# It also tells whether the model is up when a call starts: a model that is not
# up then (you stopped it) is neither stopped nor started by the call.  Unset,
# that cannot be told and the free memory decides, restore included.
# export OCR_PHASE_HEALTH_URL="http://127.0.0.1:8080/v1/models"
# Off by default.  For a server whose health URL answers before its model can
# serve: 1 also waits for a 1-token chat completion at PROOFREAD_ENDPOINT (with
# PROOFREAD_MODEL) before the model counts as restored; a URL asks that URL.
# export OCR_PHASE_READY_PROBE=1
# Time budget for ONE hand-over call, restore included.  Keep it below the agent
# harness's shell time limit (Qwen Code: 600000 ms at most, 120 s by default;
# the call must pass its own timeout).  A call that runs out exits 75: run the
# same command again; finished pages are kept.  Required whenever the model has
# to be stopped.  The installer writes 540 when it writes the commands.
# export OCR_PHASE_MAX_SECONDS=540
# auto (stop the model only when free GPU memory is short, or cannot be read),
# always, or never (the runners then load beside the model instead of deferring
# outside a hand-over window).  Only a model that is up is ever stopped and
# started again; nothing else on the GPU is ever stopped or killed: when too
# little is free the call lists what holds it and how to free it (exit 1).
# export OCR_PHASE_SWAP=auto
# Free GPU memory to require, overriding the estimate from the call's engines
# (Paddle about 12 GiB, Hunyuan from its slots x context).
# export OCR_PHASE_REQUIRED_MIB=28076
# GPU memory the model itself needs to load again (MiB); the restore waits for it.
# export OCR_PHASE_TENANT_MIB=30000
# Other clients of the model to wait for before stopping it: command-line
# substrings, comma-separated (for example the agent CLI's script path).  A
# client with a request on the wire is waited for before the stop; idle ones get
# 503 + Retry-After from a stand-in on the freed port.
# export OCR_PHASE_CLIENT_MATCH="your-agent-cli"
# Clients never waited for: command-line substrings, or uid:N for a user's
# processes (the pid -1 ones too).  A reverse proxy, an LLM gateway or a web UI
# keeps a pooled connection to the model open whether or not it has a request,
# so without this every hand-over waits for it and exits 76.
# export OCR_PHASE_CLIENT_IGNORE="nginx,litellm"
# A command that tells a person when the model could not be restored; the text
# is in $OCR_PHASE_NOTICE.
# export OCR_PHASE_NOTIFY_CMD="notify-send jyut-ocr"
# Set this to 1 ONLY when the shell that runs the hand-over has no time limit:
# the person removed the harness's cap and checked it with a command that runs
# longer than the old cap (`sleep 700; echo ok`, no timeout on the call).
# Then OCR_PHASE_MAX_SECONDS=0 runs a whole book in one call.  Unset,
# --max-seconds 0 is refused whenever the model has to be stopped, so a config
# that only says 0 fails loudly instead of being killed at the cap with the
# model down.
# export OCR_PHASE_UNLIMITED_SHELL=1

# --- where each book's working folder goes ----------------------------------------
# Renders, OCR drafts and sealed pages take gigabytes, so they are never made
# beside the PDF, which may sit in a git repo.  The files the person reads are
# copied beside the PDF anyway.  Unset, SKILL.md uses ~/jyut-ocr-books.
# export JYUT_OCR_WORK_ROOT="$HOME/jyut-ocr-books"
