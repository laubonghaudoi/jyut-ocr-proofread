  "cards": [
    {
      "dot": "cyan",
      "title": "邊個校對",
      "items": [
        "預設：當前 agent 睇裁圖答 packet 題，apply_packet_answers.py 交答案再重跑",
        "可選：本機模型，腳本經 HTTP 直接問，圖唔入 agent 嘅 context",
        "agent 本身就係本機模型（例如 Qwen Code）：一定 http，拒絕 packet"
      ]
    },
    {
      "dot": "amber",
      "title": "GPU 交接（本機模型佔住 GPU 先用）",
      "items": [
        "env.sh 有 OCR_PHASE_RELEASE_CMD：前景跑 run_ocr_phase.py -- ocr_book.py",
        "停模型前等其他 client 做完；閒置 session 收 503 加 Retry-After",
        "75 預算用完、76 GPU 忙：照 RESULT 行嘅 next call 再叫"
      ]
    },
    {
      "dot": "emerald",
      "title": "輸出規則（跟評測）",
      "items": [
        "只刪書眉、頁碼呢類頁面家具；圖表入面嘅字照轉，預設唔抽圖",
        "註腳 [^n] 留原位，重用嘅原印號改 [^n-2]",
        "直排表由右至左嘅直欄變成由上至下嘅行；跨頁續表合併",
        "印出嘅 * 寫 \\*，。。照留，冇頁碼分隔"
      ]
    },
    {
      "dot": "violet",
      "title": "交付",
      "items": [
        "X-draft.md、進度稿，最後 X.md 同 X-doubts.md 放喺 PDF 隔籬",
        "clean_book.py --all 清走工作目錄",
        "單引擎（例如 Intel Mac）係明確例外：--single-engine"
      ]
    }
  ]
